{
  "name": "uilab-core",
  "description": "Uilab base components and blocks",
  "version": "0.4.0",
  "license": "MIT",
  "author": "",
  "type": "module",
  "keywords": [
    "react",
    "react-component"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "types": "./dist/index.d.ts"
    },
    "./styles": "./dist/styles.css",
    "./styles.css": "./dist/styles.css",
    "./legacy": "./dist/legacy.css",
    "./legacy.css": "./dist/legacy.css",
    "./neutral": "./dist/neutral.css",
    "./neutral.css": "./dist/neutral.css"
  },
  "sideEffects": [
    "*.css"
  ],
  "files": [
    "dist"
  ],
  "scripts": {
    "prebuild": "rimraf ./dist",
    "build": "rollup -c",
    "release": "npm run build && npm publish",
    "format": "prettier \"src/**/*.{ts,tsx}\" --write --log-level silent",
    "lint": "eslint --max-warnings 0",
    "lint:fix": "eslint --max-warnings 0 --fix",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "devDependencies": {
    "@base-ui/react": "^1.7.0",
    "@eslint/js": "^10.0.1",
    "@shadcn/react": "^0.3.0",
    "@rollup/plugin-commonjs": "^29.0.3",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-terser": "^1.0.0",
    "@rollup/plugin-typescript": "^12.3.0",
    "@types/node": "^26.1.2",
    "@types/postcss-import": "^14.0.3",
    "@types/react": "^19.2.18",
    "@types/rollup-plugin-peer-deps-external": "^2.2.6",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "input-otp": "^1.4.2",
    "lucide-react": "^1.29.0",
    "postcss-import": "^16.1.1",
    "react": "^19.2.8",
    "react-day-picker": "^9.14.0",
    "react-dom": "^19.2.8",
    "react-hook-form": "^7.84.0",
    "react-resizable-panels": "^4.12.2",
    "rimraf": "^6.1.3",
    "rollup": "^4.62.4",
    "rollup-plugin-dts": "^6.5.1",
    "rollup-plugin-peer-deps-external": "^2.2.4",
    "rollup-plugin-postcss": "^4.0.2",
    "rollup-plugin-tsconfig-paths": "^1.5.2",
    "rollup-preserve-directives": "^1.1.3",
    "shadcn": "^4.16.2",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^6.0.2",
    "typescript-eslint": "^8.66.0",
    "vaul": "^1.1.2"
  },
  "peerDependencies": {
    "date-fns": "^4.x",
    "lucide-react": "^1.x",
    "react": "^19.x",
    "react-dom": "^19.x",
    "react-hook-form": "^7.x",
    "tailwindcss": "^4.x",
    "tw-animate-css": "^1.x"
  }
}
